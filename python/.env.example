# Configuración para el despliegue en Dell Pro Max (NVIDIA GB10) con docker-compose.
# Copia este fichero a `.env` y ajusta los valores marcados con CHANGE_ME.

# ---- Imagen base NGC (PyTorch ARM64/Blackwell) ----
# Tag del contenedor nvcr.io/nvidia/pytorch. >= 25.10 soporta GB10 (sm_121).
NGC_TAG=25.11-py3

# ---- Corpus / datos ----
# Carpeta del host con el corpus (.txt/.json del crawler ASP.NET). Se monta
# como solo-lectura en /data/corpus dentro del contenedor.
RAG_CORPUS_HOST_DIR=./corpus
RAG_CORPUS_DIR=/data/corpus
RAG_DATA_DIR=/app/data
RAG_CHUNKS_FILE=/app/data/chunks.jsonl

# ---- Qdrant (DNS de servicio en la red de compose) ----
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
RAG_COLLECTION=rag_canarias

# ---- Embeddings ----
RAG_EMBED_MODEL=intfloat/multilingual-e5-small
RAG_EMBED_DIM=384
RAG_EMBED_BATCH=32

# ---- LLM vía Ollama (DNS de servicio) ----
# 128 GB unificada permiten modelos 14B-32B. qwen2.5:14b-instruct es buen
# arranque (rápido, fuerte en español). Alternativas: qwen2.5:32b-instruct, gemma2:27b.
RAG_LLM_ENABLED=true
RAG_LLM_BASE_URL=http://ollama:11434
RAG_LLM_API_KEY=ollama
RAG_LLM_MODEL=qwen2.5:14b-instruct
RAG_LLM_TIMEOUT_SECONDS=120
RAG_LLM_MAX_TOKENS=512
RAG_LLM_MAX_CONTEXT_CHARS=6000

# ---- CORS (origen del WebForms que llega por VPN) ----
# Enumera el ORIGEN EXACTO del front (esquema+host[:puerto], sin ruta).
# Con credenciales NO vale "*": hay que listar el origen real.
RAG_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://CHANGE_ME_VPN_HOST
# Regex opcional de orígenes permitidos. String vacío = desactiva la regex y
# solo aplica la lista de arriba. El default conserva localhost/127.0.0.1.
RAG_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
