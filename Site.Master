<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="rag_can_aspx.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - RAGCAN</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script>
        (function() {
            const darkMode = localStorage.getItem('darkMode') === 'true' ||
                           (new RegExp("darkMode=true").test(document.cookie));
            if (darkMode) {
                document.documentElement.classList.add('dark-mode');
                document.body.classList.add('dark-mode');
            }
        })();
    </script>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="<%= ResolveUrl("~/Content/brand/logo_rag3.png") %>" rel="icon" type="image/png" />
    <link href="<%= ResolveUrl("~/Content/brand/logo_rag3.png") %>" rel="shortcut icon" type="image/png" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand brand-link" runat="server" href="~/Landing.aspx">
                    <span class="brand-icon">
                        <img src="<%= ResolveUrl("~/Content/brand/logo_rag3.png") %>" alt="RAGCAN" class="brand-mark" />
                    </span>
                    <span class="brand-text">
                        <span class="brand-title">
                            <span class="title-rag">RAG</span><span class="title-dark">CAN</span>
                        </span>
                    </span>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Landing.aspx">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Chat.aspx">Chat</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Crawler.aspx">Crawler</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Indexar.aspx">Indexar</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Evaluacion.aspx">Evaluación</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/About.aspx">Acerca de</a></li>
                    </ul>
                </div>
                <button id="btn-demo-api" type="button" class="btn btn-sm ms-2"
                    style="height:40px;padding:0 12px;border:1px solid rgba(255,255,255,0.4);background-color:#1a1d20;color:white;display:flex;align-items:center;gap:6px;"
                    title="Demo API — click para iniciar">
                    <span id="api-dot" style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#6c757d;flex-shrink:0;transition:background 0.4s;"></span>
                    <span id="api-label" style="font-size:12px;font-weight:600;letter-spacing:.4px;">Demo API</span>
                </button>
                <button id="dark-mode-toggle" type="button" class="btn ms-2"
                    style="width: 40px; height: 40px; padding: 0; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.9); border: 1px solid rgba(255,255,255,0.4); background-color: #343a40;"
                    title="Alternar modo oscuro" aria-pressed="false">
                    <i id="dm-icon" class="fas fa-moon" style="font-size:16px; color: inherit;"></i>
                </button>            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p>&copy; <%: DateTime.Now.Year %> - RAGCAN</p>
            </footer>
        </div>

        <asp:ContentPlaceHolder ID="PageScripts" runat="server">
        </asp:ContentPlaceHolder>
    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.bundle.js") %>
    </asp:PlaceHolder>

    <script>
        document.getElementById('dark-mode-toggle').addEventListener('click', function() {
            const isDark = document.documentElement.classList.toggle('dark-mode');
            document.body.classList.toggle('dark-mode', isDark);

            const icon = document.getElementById('dm-icon');
            icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';

            localStorage.setItem('darkMode', isDark);

            const expires = new Date();
            expires.setTime(expires.getTime() + (365 * 24 * 60 * 60 * 1000));
            document.cookie = `darkMode=${isDark}; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;
        });

        const isDark = document.documentElement.classList.contains('dark-mode');
        if (isDark) {
            document.getElementById('dm-icon').className = 'fas fa-sun';
            document.getElementById('dark-mode-toggle').setAttribute('aria-pressed', 'true');
        }
    </script>

    <script>
    (function () {
        var apiUrl = '<%= ResolveUrl("~/DemoApi.ashx") %>';
        var btn = document.getElementById('btn-demo-api');
        var dot = document.getElementById('api-dot');
        var lbl = document.getElementById('api-label');
        var apiRunning = false;
        var busy = false;

        function modelShort(model) {
            if (!model) return '';
            // "qwen3:30b-a3b-instruct-2507-q4_K_M" → "qwen3:30b"
            var m = model.split('-')[0];
            return m.length > 14 ? m.substring(0, 14) : m;
        }

        function setState(running, transitioning, d) {
            apiRunning = running;
            d = d || {};
            if (transitioning) {
                dot.style.background = '#ffc107';
                lbl.textContent = 'Iniciando…';
                btn.title = d.message || 'FastAPI iniciando…';
            } else if (running) {
                dot.style.background = d.llmRemote ? '#0d6efd' : '#28a745';
                var src = d.llmRemote ? '⚡ remoto' : '💻 local';
                lbl.textContent = 'API ON · ' + src;
                btn.title = 'FastAPI activa · ' + (d.llmModel || '') + ' — click para detener';
            } else {
                dot.style.background = '#dc3545';
                lbl.textContent = 'API OFF';
                btn.title = 'Demo API detenida — click para iniciar (detecta LLM remoto automáticamente)';
            }
        }

        function checkStatus() {
            if (busy) return;
            fetch(apiUrl + '?action=status', { cache: 'no-store' })
                .then(function (r) { return r.json(); })
                .then(function (d) { setState(d.running, false, d); })
                .catch(function () { dot.style.background = '#6c757d'; });
        }

        btn.addEventListener('click', function () {
            if (busy) return;
            busy = true;
            var action = apiRunning ? 'stop' : 'start';
            if (action === 'start') setState(false, true, {});

            fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'action=' + action
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                busy = false;
                if (action === 'start' && !d.running) {
                    setState(false, true, d);
                    var poll = setInterval(function () {
                        fetch(apiUrl + '?action=status', { cache: 'no-store' })
                            .then(function (r) { return r.json(); })
                            .then(function (d2) {
                                if (d2.running) { clearInterval(poll); setState(true, false, d2); }
                            })
                            .catch(function () {});
                    }, 2000);
                    setTimeout(function () { clearInterval(poll); checkStatus(); }, 90000);
                } else {
                    setState(d.running, false, d);
                }
            })
            .catch(function () { busy = false; checkStatus(); });
        });

        checkStatus();
        setInterval(checkStatus, 6000);
    })();
    </script>
</body>
</html>
